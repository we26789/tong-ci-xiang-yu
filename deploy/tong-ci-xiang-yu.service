[Unit]
Description=Tong Ci Xiang Yu two-player room service
After=network.target

[Service]
Type=simple
User=tongci
Group=tongci
WorkingDirectory=/opt/tong-ci-xiang-yu/current
EnvironmentFile=/etc/tong-ci-xiang-yu.env
ExecStart=/opt/tong-ci-xiang-yu/runtime/node-v24.15.0-linux-x64/bin/node --max-old-space-size=96 server.cjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M
TasksMax=128
LimitNOFILE=2048

[Install]
WantedBy=multi-user.target
